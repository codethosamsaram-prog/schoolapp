# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Storage ----------
# r2 keeps photos, documents and generated PDFs on Cloudflare R2 (10 GB free,
# no egress charges). supabase, the default, uses Supabase Storage.
STORAGE_PROVIDER=supabase
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------- Razorpay (optional; without it families pay by direct UPI) ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# ---------- WhatsApp (Meta Cloud API; optional, used for CRITICAL messages) ----------
WHATSAPP_PROVIDER=meta            # meta | interakt
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# ---------- WhatsApp (Interakt fallback) ----------
INTERAKT_API_KEY=xxxxxxxx
INTERAKT_BASE_URL=https://api.interakt.ai/v1/public

# ---------- Receipts ----------
# HMAC secret for the signed receipt links delivered over WhatsApp.
# Generate with: openssl rand -hex 32
RECEIPT_TOKEN_SECRET=change-me-to-a-64-char-random-hex

# ---------- WhatsApp health check ----------
# Lets /api/whatsapp/health read template approval status (not needed to send).
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---------- Rate limiting (production) ----------
# Shared counters for the payment and payroll rate limits only; every other
# route counts in memory. Without these, each serverless instance counts
# separately. Create a free database at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Backups (scripts/backup-db.sh; never needed by the app) ----------
# Direct connection or session pooler (port 5432), from Supabase > Connect.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
BACKUP_RETENTION_DAYS=30
